<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chiaroscuro.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Chiaroscuro.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Chiaroscuro"
        Width="900" Height="600">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Two columns: a fixed-width scrollable parameter panel on the left, and the
         (for now, text-only - the 3D viewport arrives in Phase 3) result area on the right. -->
    <Grid ColumnDefinitions="450,*">

        <ScrollViewer Grid.Column="0" Margin="12">
            <StackPanel Spacing="12">

                <Border Classes="panel" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Location &amp; Time" FontWeight="Bold" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Latitude" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                           Value="{Binding Latitude}" Increment="0.0001" FormatString="F4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Longitude" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                           Value="{Binding Longitude}" Increment="0.0001" FormatString="F4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                        SelectedDate="{Binding Date}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Time" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TimePicker Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                        SelectedTime="{Binding TimeOfDay}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="UTC Offset (h)" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1"
                                           Value="{Binding UtcOffsetHours}" Increment="0.5" FormatString="F2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Room" FontWeight="Bold" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                           Value="{Binding RoomWidth}" Increment="0.1" FormatString="F2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Length" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                           Value="{Binding RoomLength}" Increment="0.1" FormatString="F2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Height" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Value="{Binding RoomHeight}" Increment="0.1" FormatString="F2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Window" FontWeight="Bold" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Wall" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                      ItemsSource="{Binding WallOrientations}" SelectedItem="{Binding WindowWall}"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Horiz. Offset" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                           Value="{Binding WindowHorizontalOffset}" Increment="0.05" FormatString="F2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sill Height" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                           Value="{Binding WindowSillHeight}" Increment="0.05" FormatString="F2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Width" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                           Value="{Binding WindowWidth}" Increment="0.05" FormatString="F2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Height" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1"
                                           Value="{Binding WindowHeight}" Increment="0.05" FormatString="F2" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Classes="panel" Margin="0,12,12,12" Padding="16">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" VerticalAlignment="Top" />
        </Border>

    </Grid>

</Window>
