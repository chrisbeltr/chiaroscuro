<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chiaroscuro.UI.App"
             xmlns:local="using:Chiaroscuro.UI"
             RequestedThemeVariant="Dark">
             <!-- Spec calls for a *constant* dark palette, not one that follows the OS
                  theme, so this is pinned to "Dark" rather than "Default". -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Loaded after FluentTheme so our Setters win when both target the same control. -->
        <StyleInclude Source="avares://Chiaroscuro.UI/Themes/ChiaroscuroTheme.axaml" />
    </Application.Styles>
</Application>