<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette per SPEC.md "Visual & Color Scheme Requirements":
        - Background/panel/border colors are the app's constant dark blue/deep purple base.
        - Amber/gold/yellow colors are reserved EXCLUSIVELY for sun rays, light cones,
          illuminated surfaces, and other "this represents light" UI elements - never used
          as decoration elsewhere, so a glimpse of amber always means "this is light-related".
        Colors are defined once here and wrapped in SolidColorBrush resources, since XAML
        properties like Background want a Brush, not a raw Color.
    -->
    <Styles.Resources>
        <Color x:Key="ChiaroscuroBackgroundColor">#0C0A1D</Color>
        <Color x:Key="ChiaroscuroPanelColor">#120E2A</Color>
        <Color x:Key="ChiaroscuroBorderColor">#2E235A</Color>

        <!-- Body text color: not specified by SPEC.md, chosen here for readable
             high-contrast text against the deep purple background. -->
        <Color x:Key="ChiaroscuroForegroundColor">#E8E6F5</Color>

        <Color x:Key="ChiaroscuroAmberColor">#F59E0B</Color>
        <Color x:Key="ChiaroscuroGoldColor">#FBBF24</Color>
        <Color x:Key="ChiaroscuroSunYellowColor">#FDE047</Color>

        <SolidColorBrush x:Key="ChiaroscuroBackgroundBrush" Color="{StaticResource ChiaroscuroBackgroundColor}" />
        <SolidColorBrush x:Key="ChiaroscuroPanelBrush" Color="{StaticResource ChiaroscuroPanelColor}" />
        <SolidColorBrush x:Key="ChiaroscuroBorderBrush" Color="{StaticResource ChiaroscuroBorderColor}" />
        <SolidColorBrush x:Key="ChiaroscuroForegroundBrush" Color="{StaticResource ChiaroscuroForegroundColor}" />
        <SolidColorBrush x:Key="ChiaroscuroAmberBrush" Color="{StaticResource ChiaroscuroAmberColor}" />
        <SolidColorBrush x:Key="ChiaroscuroGoldBrush" Color="{StaticResource ChiaroscuroGoldColor}" />
        <SolidColorBrush x:Key="ChiaroscuroSunYellowBrush" Color="{StaticResource ChiaroscuroSunYellowColor}" />
    </Styles.Resources>

    <!-- Base look applied everywhere: dark window chrome with light, readable text. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource ChiaroscuroBackgroundBrush}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ChiaroscuroForegroundBrush}" />
    </Style>

    <!-- A reusable "panel card" look (spec: #120E2A panels with #2E235A borders) for
         grouping controls, e.g. the future parameter/settings sidebar. -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource ChiaroscuroPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChiaroscuroBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

</Styles>
